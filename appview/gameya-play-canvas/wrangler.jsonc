{
  "name": "kotodama-g4m3ya00",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"play\",\"quality-loop\",\"canvas-game\",\"agentic-playtest\"]",
    "APP_DESCRIPTION": "gameya.etzhayyim.com playable browser game with LangGraph quality loop.",
    "APP_DISPLAY_NAME": "Gameya",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "g4m3ya00",
    "APP_PERFORMER_TYPE": "game",
    "APP_UI_TYPE": "game",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "g4m3ya00.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "gameya.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
